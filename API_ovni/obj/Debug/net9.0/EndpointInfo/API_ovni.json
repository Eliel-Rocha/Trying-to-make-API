{
  "openapi": "3.0.4",
  "info": {
    "title": "API Ovni - Rastreamento ADS-B",
    "description": "API para coleta e análise de dados de tráfego aéreo capturados via Raspberry Pi (ADS-B). Projeto Acadêmico.",
    "contact": {
      "name": "Seu Nome",
      "email": "seu.email@exemplo.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Admin/GerarChaveUsuario": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "(ADMIN) Gera uma nova chave de API para um usuário e, opcionalmente, concede privilégios de Admin.",
        "parameters": [
          {
            "name": "grantAdmin",
            "in": "query",
            "description": "Define se a chave deve ter privilégios de Admin (true) ou User (false) na criação.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "description": "O nome do usuário/pesquisador.",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            },
            "text/json": {
              "schema": {
                "type": "string"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/ConfiguracaoLimpeza": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "(ADMIN) Obtém a configuração atual de limpeza para exibir na UI.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoLimpeza"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoLimpeza"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoLimpeza"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "(ADMIN) Atualiza os parâmetros de exclusão do banco de dados.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigUpdateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigUpdateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigUpdateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/ExecutarLimpeza": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Força a limpeza do banco de dados removendo a quantidade de dados \r\nnecessária para atingir a 'Meta de Ocupação' configurada.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/KeyRequest/GenerateKey": {
      "post": {
        "tags": [
          "KeyRequest"
        ],
        "summary": "(PÚBLICO) Gera uma nova chave de API (somente leitura)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/OvniData/DataPorPeriodo": {
      "get": {
        "tags": [
          "OvniData"
        ],
        "summary": "Busca de dados dentro de um período específico.",
        "parameters": [
          {
            "name": "dataInicio",
            "in": "query",
            "description": "A data de início da busca (formato: yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataFim",
            "in": "query",
            "description": "A data de fim da busca (formato: yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna a lista de avistamentos.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OvniData"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OvniData"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OvniData"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Se o formato da data for inválido.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/OvniData/InserirDocumento": {
      "post": {
        "tags": [
          "OvniData"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OvniData"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OvniData"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OvniData"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKeyRequest": {
        "required": [
          "email",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "usageDescription": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ConfigUpdateDto": {
        "required": [
          "limiteMaximoBytes",
          "percentualAlvoOcupacao"
        ],
        "type": "object",
        "properties": {
          "limiteMaximoBytes": {
            "type": "integer",
            "format": "int64"
          },
          "percentualAlvoOcupacao": {
            "maximum": 1,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ConfiguracaoLimpeza": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "limiteMaximoBytes": {
            "type": "integer",
            "format": "int64"
          },
          "percentualAlvoOcupacao": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OvniData": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "nullable": true
          },
          "hex_id": {
            "type": "string",
            "nullable": true
          },
          "flight": {
            "type": "string",
            "nullable": true
          },
          "alt_baro": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "alt_geom": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "ground_speed": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "indicated_air_speed": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "true_air_speed": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "squawk": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "track": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "emergency": {
            "type": "string",
            "nullable": true
          },
          "datetime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "Cabeçalho de autenticação usando API Key. Exemplo: 'X-Api-Key: 12345abcdef'",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    }
  ]
}